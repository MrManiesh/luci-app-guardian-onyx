#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

NAME=guardian
SCRIPT=/usr/libexec/guardian-action.sh

start_service() {
    procd_open_instance
    procd_set_param command "$SCRIPT" daemon
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    "$SCRIPT" stop 2>/dev/null
}

reload_service() {
    stop
    start
}
